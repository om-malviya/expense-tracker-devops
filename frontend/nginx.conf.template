# nginx config for the Expense Tracker frontend image.
#
# This file is a *template*: the nginx-unprivileged image runs envsubst on
# /etc/nginx/templates/*.template at container start and writes the result to
# /etc/nginx/conf.d/default.conf. That lets the same image point at a different
# backend per environment without a rebuild:
#   docker compose -> BACKEND_HOST=backend
#   Kubernetes     -> BACKEND_HOST=expense-tracker-backend (ClusterIP service name)
#
# Only ${BACKEND_HOST} and ${BACKEND_PORT} are substituted; nginx's own $variables
# are left alone because the image's entrypoint restricts envsubst to the
# variables that are actually set in the environment.

server {
  # 8080 instead of 80 because the container runs as uid 101 (non-root) and
  # unprivileged processes cannot bind ports below 1024.
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Compress text assets; the Vite bundle is mostly JS/CSS so this roughly
  # halves transfer size for first load.
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;
  gzip_vary on;

  # Vite writes hashed file names into /assets, so they can be cached forever.
  # A new build produces new hashes and index.html points at them.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Single-page app fallback: client-side routes resolve to index.html.
  # index.html itself must not be cached, otherwise browsers keep an old bundle
  # list after a deploy.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }

  # Reverse-proxy the API through the same origin so the browser never has to
  # deal with CORS and the backend service stays internal to the cluster.
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }

  # Liveness/readiness probe target for Kubernetes and the Docker HEALTHCHECK.
  # It does not touch the backend, so the frontend pod stays "healthy" even
  # while the API is restarting - the UI handles that case with an error banner.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }
}

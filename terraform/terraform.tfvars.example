# Copy to terraform.tfvars (git-ignored) and adjust.
# Never put AWS access keys in here - credentials come from `aws configure`,
# AWS_PROFILE / environment variables, or SSO.
aws_region           = "ap-south-1"
project_name         = "expense-tracker"
environment          = "dev"
vpc_cidr             = "10.30.0.0/16"
azs                  = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs  = ["10.30.101.0/24", "10.30.102.0/24"]
private_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
cluster_version      = "1.31"
node_instance_types  = ["t3.medium"]
node_min_size        = 1
node_desired_size    = 2
node_max_size        = 3

cluster_endpoint_public_access = true

tags = {
  Course     = "devops-capstone"
  Enrollment = "24BCS10448"
}

# Copy to backend/.env for local development (the real .env is git-ignored).
APP_NAME=Expense Tracker API
APP_ENV=local
LOG_LEVEL=info
# Password is the docker-compose placeholder; production injects DATABASE_URL from a Kubernetes Secret.
DATABASE_URL=postgresql+psycopg://expenses:expenses-local-only@localhost:5432/expenses
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
